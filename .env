# Environment variables for LinkedIn Job Watcher

# -- Search Configuration --
# Keywords/titles to search for (use LinkedIn operators like OR, AND, NOT, parentheses, quotes)
SEARCH_KEYWORDS="quality assurance OR QA Engineer OR Senior QA Engineer OR QA Manager OR Quality Assurance Manager"

# Location to search within
SEARCH_LOCATION="United States"

# Filter for jobs posted within the last X minutes (e.g., 60 for last hour, 1440 for last 24 hours)
SEARCH_POSTED_MINUTES=60 # Default to 24 hours

# Workplace Type Filter (Optional)
# Options: "Remote", "Hybrid", "RemoteOrHybrid", "OnSite", or leave empty for Any
SEARCH_WORKPLACE_TYPE="RemoteOrHybrid"

# Job Function Filter (Optional)
# Options: Comma-separated codes (e.g., "it,eng,qa,prjm") or leave empty for no filter
SEARCH_JOB_FUNCTIONS="it,eng,qa,prjm"

# -- Discord Configuration --
# Discord Webhook URL (replace with your webhook URL)
DISCORD_WEBHOOK_URL="DISCORD_WEBHOOK_URL"

# -- Script Configuration --
# Refresh interval in minutes (e.g., 10 for every 10 minutes)
# REFRESH_INTERVAL_MINUTES=10 # Old setting, keeping for reference

# Refresh interval in seconds (e.g., 10 for every 10 seconds)
REFRESH_INTERVAL_SECONDS=10

# Optional: Path to Chrome user data directory for persistent login
# Use a relative path to create a dedicated profile directory within the project:
CHROME_USER_DATA_DIR="./chrome-profile" 